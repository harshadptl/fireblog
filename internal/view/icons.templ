package view

// Inline SVG icons (Lucide-style, MIT). currentColor makes them follow text color.
templ svgIcon() {
	<svg class="i" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		{ children... }
	</svg>
}

templ iconLogo() {
	<svg class="logo" width="28" height="28" viewBox="0 0 32 32" aria-hidden="true">
		<rect width="32" height="32" rx="8" fill="currentColor"></rect>
		<path class="logo-mark" d="M10 22c0-7 4-12 12-12-1 5-4 8-8 9l-4 3z"></path>
	</svg>
}

templ iconPen() {
	@svgIcon() {
		<path d="M12 20h9"></path>
		<path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"></path>
	}
}

templ iconSun() {
	@svgIcon() {
		<circle cx="12" cy="12" r="4"></circle>
		<path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
	}
}

templ iconMoon() {
	@svgIcon() {
		<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
	}
}

templ iconHeart() {
	@svgIcon() {
		<path d="M19 14c1.5-1.5 3-3.2 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.8 0-3 .5-4.5 2-1.5-1.5-2.7-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4 3 5.5l7 7Z"></path>
	}
}

templ iconBookmark() {
	@svgIcon() {
		<path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"></path>
	}
}

templ iconComment() {
	@svgIcon() {
		<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
	}
}

templ iconEye() {
	@svgIcon() {
		<path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
		<circle cx="12" cy="12" r="3"></circle>
	}
}

templ iconClock() {
	@svgIcon() {
		<circle cx="12" cy="12" r="10"></circle>
		<path d="M12 6v6l4 2"></path>
	}
}

templ iconTrash() {
	@svgIcon() {
		<path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path>
	}
}

templ iconLink() {
	@svgIcon() {
		<path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"></path>
		<path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"></path>
	}
}

templ iconArrowLeft() {
	@svgIcon() {
		<path d="M19 12H5M12 19l-7-7 7-7"></path>
	}
}

templ iconGoogle() {
	<svg class="i" width="18" height="18" viewBox="0 0 48 48" aria-hidden="true">
		<path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"></path>
		<path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"></path>
		<path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2A11.9 11.9 0 0 1 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z"></path>
		<path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3a12 12 0 0 1-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"></path>
	</svg>
}
